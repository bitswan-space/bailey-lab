# The suite's stand-ins, applied separately from the Bailey and before it, so
# the Bailey install stays visibly two commands.
#
# Neither of these is part of a Bailey. Keycloak is the identity provider a real
# install gets from the AOC, and the collector is the SIEM target the walkthrough
# points Bailey's audit forwarding at. Both mirror what e2e/bringup.sh runs as
# plain containers, with one difference: the collector's Service keeps the same
# NAME the Docker suite uses as a container name, so the walkthrough's endpoint
# strings are unchanged.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: keycloak-realm
data:
  realm-export.json: |
${REALM_JSON_INDENTED}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: keycloak
  labels:
    app.kubernetes.io/name: keycloak
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: keycloak
  template:
    metadata:
      labels:
        app.kubernetes.io/name: keycloak
    spec:
      containers:
        - name: keycloak
          image: ${KEYCLOAK_IMAGE}
          imagePullPolicy: IfNotPresent
          args: ["start-dev", "--import-realm"]
          env:
            - name: KC_BOOTSTRAP_ADMIN_USERNAME
              value: admin
            - name: KC_BOOTSTRAP_ADMIN_PASSWORD
              value: admin
            - name: KC_HTTP_ENABLED
              value: "true"
            - name: KC_HTTP_PORT
              value: "${KC_PORT}"
            - name: KC_HOSTNAME
              value: http://${KC_HOST}:${KC_PORT}
            - name: KC_HOSTNAME_BACKCHANNEL_DYNAMIC
              value: "true"
            - name: KC_PROXY_HEADERS
              value: xforwarded
          ports:
            # hostPort, not a NodePort: the browser on the node and every pod
            # must reach the issuer at the SAME url or the iss claim mismatches
            # on one of the two legs. This is the Docker suite's `-p 8088:8088`.
            - containerPort: ${KC_PORT}
              hostPort: ${KC_PORT}
          volumeMounts:
            - name: realm
              mountPath: /opt/keycloak/data/import
              readOnly: true
      volumes:
        - name: realm
          configMap:
            name: keycloak-realm
---
apiVersion: v1
kind: Service
metadata:
  name: keycloak
  labels:
    app.kubernetes.io/name: keycloak
spec:
  selector:
    app.kubernetes.io/name: keycloak
  ports:
    - name: http
      port: ${KC_PORT}
      targetPort: ${KC_PORT}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: otel-collector-config
data:
  config.yaml: |
${OTEL_CONFIG_INDENTED}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bitswan-e2e-otel
  labels:
    app.kubernetes.io/name: bitswan-e2e-otel
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: bitswan-e2e-otel
  template:
    metadata:
      labels:
        app.kubernetes.io/name: bitswan-e2e-otel
    spec:
      containers:
        - name: collector
          image: ${OTEL_IMAGE}
          imagePullPolicy: IfNotPresent
          args: ["--config", "/etc/otelcol/config.yaml"]
          ports:
            - containerPort: 4317
            - containerPort: 4318
          volumeMounts:
            - name: config
              mountPath: /etc/otelcol
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: otel-collector-config
---
apiVersion: v1
kind: Service
metadata:
  name: bitswan-e2e-otel
  labels:
    app.kubernetes.io/name: bitswan-e2e-otel
spec:
  selector:
    app.kubernetes.io/name: bitswan-e2e-otel
  ports:
    - name: grpc
      port: 4317
      targetPort: 4317
    - name: http
      port: 4318
      targetPort: 4318
