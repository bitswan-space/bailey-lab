# Keycloak: the identity provider a real install gets from the AOC.
#
# It lives in its own namespace because it needs a hostPort — the browser on the
# node and every pod must reach the issuer at the SAME url or the iss claim
# mismatches on one leg — and hostPort is forbidden by the PodSecurity baseline
# profile the Bailey's namespace enforces for the egress firewall's NET_ADMIN.
# Nothing is lost: both legs reach it by hostname, not by Service DNS.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: keycloak-realm
data:
  realm-export.json: |
${REALM_JSON_INDENTED}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: keycloak
  labels:
    app.kubernetes.io/name: keycloak
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: keycloak
  template:
    metadata:
      labels:
        app.kubernetes.io/name: keycloak
    spec:
      containers:
        - name: keycloak
          image: ${KEYCLOAK_IMAGE}
          imagePullPolicy: IfNotPresent
          args: ["start-dev", "--import-realm"]
          env:
            - name: KC_BOOTSTRAP_ADMIN_USERNAME
              value: admin
            - name: KC_BOOTSTRAP_ADMIN_PASSWORD
              value: admin
            - name: KC_HTTP_ENABLED
              value: "true"
            - name: KC_HTTP_PORT
              value: "${KC_PORT}"
            - name: KC_HOSTNAME
              value: http://${KC_HOST}:${KC_PORT}
            - name: KC_HOSTNAME_BACKCHANNEL_DYNAMIC
              value: "true"
            - name: KC_PROXY_HEADERS
              value: xforwarded
          ports:
            # hostPort, not a NodePort: the browser on the node and every pod
            # must reach the issuer at the SAME url or the iss claim mismatches
            # on one of the two legs. This is the Docker suite's `-p 8088:8088`.
            - containerPort: ${KC_PORT}
              hostPort: ${KC_PORT}
          volumeMounts:
            - name: realm
              mountPath: /opt/keycloak/data/import
              readOnly: true
      volumes:
        - name: realm
          configMap:
            name: keycloak-realm
---
apiVersion: v1
kind: Service
metadata:
  name: keycloak
  labels:
    app.kubernetes.io/name: keycloak
spec:
  selector:
    app.kubernetes.io/name: keycloak
  ports:
    - name: http
      port: ${KC_PORT}
      targetPort: ${KC_PORT}
