---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: bitswan-registry
  labels:
    app.kubernetes.io/managed-by: bitswan
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: ${REGISTRY_STORAGE}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bitswan-registry
  labels:
    app.kubernetes.io/name: bitswan-registry
    app.kubernetes.io/managed-by: bitswan
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: bitswan-registry
  template:
    metadata:
      labels:
        app.kubernetes.io/name: bitswan-registry
        app.kubernetes.io/managed-by: bitswan
    spec:
      automountServiceAccountToken: false
      containers:
        - name: registry
          image: ${REGISTRY_IMAGE}
          imagePullPolicy: IfNotPresent
          env:
            - name: REGISTRY_STORAGE_DELETE_ENABLED
              value: "true"
          ports:
            - name: registry
              containerPort: 5000
          volumeMounts:
            - name: data
              mountPath: /var/lib/registry
          readinessProbe:
            httpGet:
              path: /v2/
              port: 5000
            periodSeconds: 3
            failureThreshold: 60
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: bitswan-registry
---
apiVersion: v1
kind: Service
metadata:
  name: bitswan-registry
  labels:
    app.kubernetes.io/name: bitswan-registry
    app.kubernetes.io/managed-by: bitswan
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: bitswan-registry
  ports:
    - name: registry
      port: 5000
      targetPort: 5000
      nodePort: ${REGISTRY_NODE_PORT}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bitswan-buildkit
  labels:
    app.kubernetes.io/name: bitswan-buildkit
    app.kubernetes.io/managed-by: bitswan
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: bitswan-buildkit
  template:
    metadata:
      labels:
        app.kubernetes.io/name: bitswan-buildkit
        app.kubernetes.io/managed-by: bitswan
      annotations:
        container.apparmor.security.beta.kubernetes.io/buildkitd: unconfined
    spec:
      automountServiceAccountToken: false
      containers:
        - name: buildkitd
          image: ${BUILDKIT_IMAGE}
          imagePullPolicy: IfNotPresent
          args:
            - --addr
            - tcp://0.0.0.0:1234
            - --addr
            - unix:///run/user/1000/buildkit/buildkitd.sock
            - --oci-worker-no-process-sandbox
            - --config
            - /etc/buildkit/buildkitd.toml
          securityContext:
            seccompProfile:
              type: Unconfined
            runAsUser: 1000
            runAsGroup: 1000
          ports:
            - name: grpc
              containerPort: 1234
          volumeMounts:
            - name: cache
              mountPath: /home/user/.local/share/buildkit
            - name: config
              mountPath: /etc/buildkit
          readinessProbe:
            exec:
              command: ["buildctl", "debug", "workers"]
            periodSeconds: 5
            failureThreshold: 60
      volumes:
        - name: cache
          emptyDir: {}
        - name: config
          configMap:
            name: bitswan-buildkit
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: bitswan-buildkit
  labels:
    app.kubernetes.io/name: bitswan-buildkit
    app.kubernetes.io/managed-by: bitswan
data:
  buildkitd.toml: |
    [registry."bitswan-registry:5000"]
      http = true
      insecure = true
---
apiVersion: v1
kind: Service
metadata:
  name: bitswan-buildkit
  labels:
    app.kubernetes.io/name: bitswan-buildkit
    app.kubernetes.io/managed-by: bitswan
spec:
  selector:
    app.kubernetes.io/name: bitswan-buildkit
  ports:
    - name: grpc
      port: 1234
      targetPort: 1234
