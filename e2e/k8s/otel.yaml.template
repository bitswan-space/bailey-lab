# The OTLP collector: the SIEM target the walkthrough points Bailey's audit
# forwarding at.
#
# In the Bailey's own namespace, and its Service keeps the NAME the Docker suite
# uses as a container name, so the walkthrough's endpoint strings are unchanged.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: otel-collector-config
data:
  config.yaml: |
${OTEL_CONFIG_INDENTED}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bitswan-e2e-otel
  labels:
    app.kubernetes.io/name: bitswan-e2e-otel
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: bitswan-e2e-otel
  template:
    metadata:
      labels:
        app.kubernetes.io/name: bitswan-e2e-otel
    spec:
      containers:
        - name: collector
          image: ${OTEL_IMAGE}
          imagePullPolicy: IfNotPresent
          args: ["--config", "/etc/otelcol/config.yaml"]
          ports:
            - containerPort: 4317
            - containerPort: 4318
          volumeMounts:
            - name: config
              mountPath: /etc/otelcol
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: otel-collector-config
---
apiVersion: v1
kind: Service
metadata:
  name: bitswan-e2e-otel
  labels:
    app.kubernetes.io/name: bitswan-e2e-otel
spec:
  selector:
    app.kubernetes.io/name: bitswan-e2e-otel
  ports:
    - name: grpc
      port: 4317
      targetPort: 4317
    - name: http
      port: 4318
      targetPort: 4318
