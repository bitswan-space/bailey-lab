# A Bailey in one namespace: the control plane the AOC-rendered seed will carry.
#
# The shape is proven here first, against a real k3s, and then ported into the Go
# renderer the AOC serves — so the thing operators apply is the thing the suite
# applies. Substituted with envsubst; every ${VAR} is set by bringup-k8s.sh.
#
# Everything is in ONE pod on purpose:
#   - ingress is a file. The daemon writes traefik/dynamic.yml and Traefik's file
#     provider watches it; there is no API call and no CRD, so the writer and the
#     reader must see the same filesystem, which on an RWO volume means one pod.
#   - the auth proxy, the gate and the ACME bridge become loopback, so they are
#     reachable by nothing else. On a Docker host every container on
#     bitswan_network can reach the gate and the bridge.
#   - one writer for the RWO PVC, and a deterministic pod name for a scoped
#     self-restart.
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: bailey
  labels:
    app.kubernetes.io/name: bailey
    app.kubernetes.io/managed-by: bitswan
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: bailey
  labels:
    app.kubernetes.io/name: bailey
    app.kubernetes.io/managed-by: bitswan
rules:
  # Traefik's static config is not watched, so applying a change to it means
  # replacing the pod. Scoped to this one object by name: patching the Deployment
  # is enough to restart, and nothing else needs writing.
  - apiGroups: ["apps"]
    resources: ["deployments"]
    resourceNames: ["bailey"]
    verbs: ["get", "patch"]
  - apiGroups: [""]
    resources: ["pods", "pods/log", "events"]
    verbs: ["get", "list", "watch"]
  # Creating a workspace means creating the services it runs. This is the
  # namespace's form of the Docker socket the daemon holds on a host — and a far
  # narrower one: it can act in this namespace and nowhere else, and the API
  # server enforces that rather than trusting the daemon to scope itself.
  - apiGroups: ["apps"]
    resources: ["deployments"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: [""]
    resources: ["services", "configmaps", "secrets"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: ["networking.k8s.io"]
    resources: ["networkpolicies"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  # Claims can be created but never deleted: a workspace's data outliving a
  # mistake is enforced by the API server, not by remembering not to.
  - apiGroups: [""]
    resources: ["persistentvolumeclaims"]
    verbs: ["get", "list", "watch", "create", "patch"]
  # What the namespace is allowed to use, which is the honest replacement for
  # reading the node's /proc/meminfo as if it were this server's budget.
  - apiGroups: [""]
    resources: ["resourcequotas", "limitranges"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: bailey
  labels:
    app.kubernetes.io/name: bailey
    app.kubernetes.io/managed-by: bitswan
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: bailey
subjects:
  # A ServiceAccount subject must name its namespace — there is no "my own
  # namespace" token — which is the one reason the seed cannot be namespace
  # agnostic, and therefore why the operator sees the namespace as a field.
  - kind: ServiceAccount
    name: bailey
    namespace: ${NAMESPACE}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: bitswan-infra-driver
  labels:
    app.kubernetes.io/managed-by: bitswan
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: bitswan-infra-driver
  labels:
    app.kubernetes.io/managed-by: bitswan
rules:
  # What a business process becomes. This is the namespace's form of the Docker
  # socket the driver holds on a host, and far narrower than one: it can create
  # workloads in this namespace and cannot touch a node, a namespace, or RBAC —
  # so it cannot grant itself anything it was not given.
  - apiGroups: ["apps"]
    resources: ["deployments", "statefulsets"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: ["apps"]
    resources: ["deployments/scale", "statefulsets/scale"]
    verbs: ["get", "update", "patch"]
  - apiGroups: ["apps"]
    resources: ["replicasets"]
    verbs: ["get", "list", "watch"]
  - apiGroups: [""]
    resources: ["services", "configmaps", "secrets"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: [""]
    resources: ["pods", "pods/log", "events"]
    verbs: ["get", "list", "watch", "delete"]
  - apiGroups: [""]
    resources: ["pods/exec"]
    verbs: ["create"]
  - apiGroups: ["networking.k8s.io"]
    resources: ["networkpolicies"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  # Created, never deleted: a business process losing its database to a bad
  # reconcile should be impossible rather than unlikely.
  - apiGroups: [""]
    resources: ["persistentvolumeclaims"]
    verbs: ["get", "list", "watch", "create", "patch"]
  - apiGroups: ["metrics.k8s.io"]
    resources: ["pods"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: bitswan-infra-driver
  labels:
    app.kubernetes.io/managed-by: bitswan
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: bitswan-infra-driver
subjects:
  - kind: ServiceAccount
    name: bitswan-infra-driver
    namespace: ${NAMESPACE}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: bailey-config
  labels:
    app.kubernetes.io/name: bailey
    app.kubernetes.io/managed-by: bitswan
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: ${STORAGE_SIZE}
  # storageClassName is deliberately absent: that selects the cluster's default
  # class. An empty string would mean "no dynamic provisioning" and the claim
  # would stay Pending forever.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: bailey-seed
  labels:
    app.kubernetes.io/name: bailey
    app.kubernetes.io/managed-by: bitswan
data:
  expected-namespace: ${NAMESPACE}
  platform: kubernetes
  domain: ${DOMAIN}
---
apiVersion: v1
kind: Secret
metadata:
  name: bailey-oauth
  labels:
    app.kubernetes.io/name: bailey
    app.kubernetes.io/managed-by: bitswan
type: Opaque
stringData:
  # The auth proxy's whole configuration, as the environment it already reads.
  # A sibling container's environment is fixed when the pod is created, so this
  # is a Secret the proxy envFroms rather than a file the daemon renders — the
  # native shape, and it rolls the pod when it changes.
  OAUTH2_PROXY_PROVIDER: oidc
  OAUTH2_PROXY_OIDC_ISSUER_URL: ${OIDC_ISSUER}
  OAUTH2_PROXY_CLIENT_ID: ${OIDC_CLIENT_ID}
  OAUTH2_PROXY_CLIENT_SECRET: ${OIDC_CLIENT_SECRET}
  OAUTH2_PROXY_COOKIE_SECRET: ${OIDC_COOKIE_SECRET}
  OAUTH2_PROXY_EMAIL_DOMAINS: "*"
  OAUTH2_PROXY_SCOPE: openid email profile
  OAUTH2_PROXY_UPSTREAMS: http://127.0.0.1:9080
  OAUTH2_PROXY_HTTP_ADDRESS: 0.0.0.0:4180
  OAUTH2_PROXY_REVERSE_PROXY: "true"
  OAUTH2_PROXY_PASS_HOST_HEADER: "true"
  OAUTH2_PROXY_PASS_USER_HEADERS: "true"
  OAUTH2_PROXY_SET_XAUTHREQUEST: "true"
  OAUTH2_PROXY_PASS_ACCESS_TOKEN: "true"
  OAUTH2_PROXY_SKIP_PROVIDER_BUTTON: "true"
  OAUTH2_PROXY_REDIRECT_URL: https://bailey.${DOMAIN}/oauth2/callback
  OAUTH2_PROXY_COOKIE_DOMAINS: .${DOMAIN}
  OAUTH2_PROXY_WHITELIST_DOMAINS: .${DOMAIN},${OIDC_HOST}
  OAUTH2_PROXY_COOKIE_SECURE: "true"
  OAUTH2_PROXY_COOKIE_SAMESITE: none
  OAUTH2_PROXY_COOKIE_CSRF_PER_REQUEST: "true"
  OAUTH2_PROXY_COOKIE_CSRF_EXPIRE: 1h
  OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL: "true"
---
apiVersion: v1
kind: Service
metadata:
  name: bailey
  labels:
    app.kubernetes.io/name: bailey
    app.kubernetes.io/managed-by: bitswan
spec:
  # Headless, and here only because a StatefulSet requires a governing Service.
  # A Bailey reached through the AOC's relay publishes nothing at all; this suite
  # reaches it on the node, which is what bailey-ingress below is for.
  clusterIP: None
  selector:
    app.kubernetes.io/name: bailey
  ports:
    - name: http
      port: 80
    - name: https
      port: 443
---
apiVersion: v1
kind: Service
metadata:
  name: bailey-ingress
  labels:
    app.kubernetes.io/name: bailey
    app.kubernetes.io/managed-by: bitswan
spec:
  type: LoadBalancer
  selector:
    app.kubernetes.io/name: bailey
  ports:
    - name: http
      port: 80
      targetPort: 80
    - name: https
      port: 443
      targetPort: 443
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bailey
  labels:
    app.kubernetes.io/name: bailey
    app.kubernetes.io/managed-by: bitswan
spec:
  replicas: 1
  # Recreate, not RollingUpdate: the volume has exactly one writer, so a second
  # pod must never exist alongside the first. A StatefulSet would give the same
  # guarantee and a stable pod name, but it also refuses to replace a pod that is
  # not Ready — so a bad config deadlocks its own fix. A Deployment always
  # replaces, and the object name is stable even though the pod name is not.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: bailey
  template:
    metadata:
      labels:
        app.kubernetes.io/name: bailey
        app.kubernetes.io/managed-by: bitswan
        bitswan.io/role: control-plane
    spec:
      serviceAccountName: bailey
      terminationGracePeriodSeconds: 30
      securityContext:
        fsGroup: 0
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: bailey-config
        - name: run
          emptyDir: {}
      initContainers:
        # Docker creates a missing bind source as an empty directory; Kubernetes
        # refuses to start a container whose subPath does not exist. So the
        # layout the daemon and Traefik both expect is made here, before either
        # starts, and Traefik gets a config valid enough to come up on — the
        # daemon replaces it with the real one once it knows its domain.
        - name: seed-state
          image: ${DAEMON_IMAGE}
          imagePullPolicy: ${PULL_POLICY}
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -e
              cd /root/.config/bitswan
              mkdir -p traefik/certs traefik/acme protected-proxy
              if [ ! -s traefik/traefik.yml ]; then
                cat > traefik/traefik.yml <<'YAML'
              entryPoints:
                web:
                  address: ":80"
                websecure:
                  address: ":443"
              providers:
                file:
                  filename: /etc/traefik/dynamic.yml
                  watch: true
              YAML
              fi
              [ -s traefik/dynamic.yml ] || printf '{}\n' > traefik/dynamic.yml
              CFG=automation_server_config.toml
              touch "$CFG"
              grep -q '^protected_domain' "$CFG" || \
                printf 'protected_domain = "%s"\n%s' "${DOMAIN}" "$(cat "$CFG")" > "$CFG.new" \
                && mv -f "$CFG.new" "$CFG" 2>/dev/null || true
              ls -la . traefik
          volumeMounts:
            - name: config
              mountPath: /root/.config/bitswan
      containers:
        - name: daemon
          image: ${DAEMON_IMAGE}
          imagePullPolicy: ${PULL_POLICY}
          command: ["/usr/local/bin/bitswan", "automation-server-daemon", "__run"]
          env:
            - name: BITSWAN_PLATFORM
              value: kubernetes
            - name: BITSWAN_RELAY_LOCAL_TARGET
              value: 127.0.0.1:443
            - name: HOME
              value: /root
            - name: BITSWAN_K8S_VOLUME_CLAIM
              value: bailey-config
            - name: BITSWAN_K8S_PULL_POLICY
              value: ${PULL_POLICY}
            - name: BITSWAN_GITOPS_IMAGE
              value: ${GITOPS_IMAGE}
            - name: BITSWAN_DASHBOARD_IMAGE
              value: ${DASHBOARD_IMAGE}
            - name: BITSWAN_CODING_AGENT_IMAGE
              value: ${CODING_AGENT_IMAGE}
            - name: BITSWAN_INFRA_DRIVER_IMAGE
              value: ${INFRA_DRIVER_IMAGE}
          ports:
            - name: docs
              containerPort: 8080
            - name: gate
              containerPort: 9080
          volumeMounts:
            - name: config
              mountPath: /root/.config/bitswan
            - name: run
              mountPath: /var/run/bitswan
        - name: traefik
          image: ${TRAEFIK_IMAGE}
          args: ["--configFile=/etc/traefik/traefik.yml"]
          ports:
            - name: http
              containerPort: 80
            - name: https
              containerPort: 443
          volumeMounts:
            - name: config
              mountPath: /etc/traefik/traefik.yml
              subPath: traefik/traefik.yml
            - name: config
              mountPath: /etc/traefik/dynamic.yml
              subPath: traefik/dynamic.yml
            - name: config
              mountPath: /tls
              subPath: traefik/certs
            - name: config
              mountPath: /acme
              subPath: traefik/acme
        - name: protected-proxy
          image: ${PROXY_IMAGE}
          envFrom:
            - secretRef:
                name: bailey-oauth
          # Traefik reaches the proxy over loopback in this pod, and the proxy
          # forwards to the gate beside it — but the readiness probe comes from
          # the kubelet, for which 127.0.0.1 is the NODE's loopback, so the
          # listener binds the pod's addresses and a NetworkPolicy is what keeps
          # it private rather than the bind address.
          readinessProbe:
            httpGet:
              path: /ping
              port: 4180
            initialDelaySeconds: 2
            periodSeconds: 3
        - name: redis
          image: ${REDIS_IMAGE}
          args: ["--appendonly", "yes", "--bind", "127.0.0.1", "--dir", "/data"]
          # The session store has no password and must not be reachable by
          # anything but the proxy. On a Docker host that needs a private network
          # and a comment explaining why; bound to loopback in a shared pod it is
          # unreachable from outside by construction.
          volumeMounts:
            - name: config
              mountPath: /data
              subPath: protected-proxy-redis
