#!/bin/bash
# Seed the Playwright browser MCP config (.mcp.json, #210) into every app
# root of ONE copy — app roots are located by their process.toml (copies
# nest as copies/<copy>/<app>/, so never assume a fixed depth). Called from
# entrypoint-agent.sh for each copy present at container start, and from
# agent-session-wrapper at session start so copies created while the
# container is running get covered too.
#
# Seed-if-missing: the file is a user-ownable bootstrap they may extend
# with their own MCP servers. Seeded/generated files are kept out of the
# copy's git status via .git/info/exclude (local-only ignore). Runs as
# root from the entrypoint but as the agent user from the wrapper, so
# chown only when we're root.
set -u
copy_dir="${1:?usage: seed-copy-mcp <copy-dir>}"
[ -f /etc/bitswan/mcp.json ] || exit 0
[ -d "$copy_dir" ] || exit 0

while IFS= read -r toml; do
    wt="$(dirname "$toml")"
    if [ ! -f "$wt/.mcp.json" ]; then
        cp /etc/bitswan/mcp.json "$wt/.mcp.json"
        if [ "$(id -u)" = "0" ]; then
            chown agent:agent "$wt/.mcp.json"
        fi
    fi
    if [ -d "$wt/.git" ]; then
        exclude="$wt/.git/info/exclude"
        mkdir -p "$wt/.git/info"
        for pat in /.mcp.json /.playwright-mcp/; do
            grep -qxF "$pat" "$exclude" 2>/dev/null || echo "$pat" >> "$exclude"
        done
    fi
done < <(find "$copy_dir" -mindepth 1 -maxdepth 2 -name process.toml 2>/dev/null)
