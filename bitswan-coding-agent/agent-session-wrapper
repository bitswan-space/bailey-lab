#!/bin/bash
# Session wrapper for SSH connections to the coding agent container
# (sshd ForceCommand). Every session is dashboard-driven and scoped to one
# (user, copy, BP): interactive sessions run Claude inside dtach so the
# conversation survives disconnects; non-interactive sessions
# (SSH_ORIGINAL_COMMAND) just run the command and pipe it back.

USER_EMAIL="${SSH_USER_EMAIL:-}"
COPY="${SSH_WORKTREE:-}"
BP="${SSH_BP:-}"
# Claude session UUID — passed by the dashboard so it can resume later via
# `claude --resume <uuid>`. Keys the dtach socket and the .meta.json below.
CLAUDE_SESSION_ID="${SSH_CLAUDE_SESSION_ID:-}"
AUTO_CMD="${SSH_AUTO_CMD:-}"

# Every session must carry the user's identity: it keys the per-user Claude
# config dir and attributes git commits. The dashboard always sends it.
if [ -z "$USER_EMAIL" ] || [ "$USER_EMAIL" = "unknown" ]; then
    echo "agent-session-wrapper: SSH_USER_EMAIL not set; refusing to start" >&2
    exit 1
fi

# Per-user Claude config dir keyed off the oauth2-proxy email. Without it,
# whichever user logs into `claude` first leaks their account to every other
# user of this container. Email is sanitized + hashed to defang RFC-valid
# local parts that can contain `/` or `..`. MUST stay byte-identical with
# `sanitizeEmail` in the dashboard server (services/agent-sessions.ts) — both
# sides have to produce the same slug for the same email.
sanitize_email() {
    local raw="$1"
    local clean hash
    clean=$(printf '%s' "$raw" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '_' | cut -c1-40)
    hash=$(printf '%s' "$raw" | sha256sum | head -c 8)
    printf '%s_%s' "$clean" "$hash"
}
EMAIL_SLUG=$(sanitize_email "$USER_EMAIL")
export CLAUDE_CONFIG_DIR="/home/agent/.claude_${EMAIL_SLUG}"
mkdir -p "$CLAUDE_CONFIG_DIR"

# Attribute git commits made during this session to the actual user. Per-process
# GIT_* env vars (not global git config) so concurrent sessions in this shared
# container don't race. Covers both the interactive and the non-interactive
# (SSH_ORIGINAL_COMMAND) paths below.
export GIT_AUTHOR_NAME="$USER_EMAIL"
export GIT_AUTHOR_EMAIL="$USER_EMAIL"
export GIT_COMMITTER_NAME="$USER_EMAIL"
export GIT_COMMITTER_EMAIL="$USER_EMAIL"

SESSION_DIR="/var/log/agent-sessions"

# Land in the BP directory (every dashboard session is BP-scoped); the copy
# root is the fallback for one-shot commands that only set SSH_WORKTREE.
if [ -n "$BP" ] && [ -d "/workspace/copies/${COPY}/${BP}" ]; then
    cd "/workspace/copies/${COPY}/${BP}"
elif [ -n "$COPY" ] && [ -d "/workspace/copies/${COPY}" ]; then
    cd "/workspace/copies/${COPY}"
fi

# Non-interactive one-shot command (dashboard's agent-exec path): run it and
# pipe the output straight back.
if [ -n "$SSH_ORIGINAL_COMMAND" ]; then
    exec bash -c "$SSH_ORIGINAL_COMMAND"
fi

# Metadata for the dashboard's session lookup, one file per Claude
# conversation. Overwritten on every attach so `started_at` reflects the most
# recent attach — the dashboard picks a scope's resume candidate by it.
if [ -n "$CLAUDE_SESSION_ID" ]; then
    if [ -n "$BP" ]; then
        BP_JSON="\"${BP}\""
    else
        BP_JSON="null"
    fi
    cat > "${SESSION_DIR}/${CLAUDE_SESSION_ID}.meta.json" << METAEOF
{
  "user_email": "${USER_EMAIL}",
  "worktree": "${COPY}",
  "bp": ${BP_JSON},
  "claude_session_id": "${CLAUDE_SESSION_ID}",
  "started_at": "$(date -Iseconds)"
}
METAEOF
fi

# Determine the shell command to run
SHELL_CMD="bash -l"
if [ -n "$AUTO_CMD" ]; then
    # Write auto command to a temp script to avoid quoting issues
    AUTO_SCRIPT="/tmp/.auto_cmd_$$.sh"
    echo "$AUTO_CMD" > "$AUTO_SCRIPT"
    chmod +x "$AUTO_SCRIPT"
    SHELL_CMD="bash -l $AUTO_SCRIPT"
fi

# Browser-close persistence: when the dashboard passes a Claude session
# UUID, wrap the shell in dtach so the underlying claude process survives
# ssh disconnects. `dtach -A` attaches to an existing socket OR creates a
# new one running the trailing command. When the user reconnects (or
# clicks Resume), the same dtach socket is found and they pick up exactly
# where the agent left off — no `--resume` needed for the still-running
# case. Idle close on the dashboard server kills the underlying process,
# at which point dtach removes the socket, so the *next* attach starts
# fresh from claude's on-disk history via `--resume <uuid>`.
#
# `-r winch`: on (re)attach, send a SIGWINCH so Claude's full-screen TUI
# repaints immediately. dtach's default redraw method is ctrl_l, which Claude
# (an Ink/React app that only repaints on resize) ignores — without this the
# reattached terminal stays blank until the user manually resizes the window.
if [ -n "$CLAUDE_SESSION_ID" ]; then
    exec dtach -A "/tmp/.claude-dtach-${CLAUDE_SESSION_ID}.sock" -z -r winch $SHELL_CMD
fi

exec $SHELL_CMD
