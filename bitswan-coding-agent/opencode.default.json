{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp",
        "--headless",
        "--no-sandbox",
        "--browser",
        "chromium",
        "--storage-state",
        "/home/agent/.bitswan-browser-state.json"
      ]
    }
  }
}
