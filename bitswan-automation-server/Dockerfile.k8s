# The automation server as a self-contained image.
#
# The runtime image deliberately ships WITHOUT the bitswan binary: on a Docker
# host the daemon container gets it bind-mounted from the host, which is what
# makes `bitswan self-update` a file swap and a container restart. A pod has no
# host to mount from, so the binary has to be in the image, and the image tag
# becomes the thing that names the version.
#
# Built from the same base so a namespace Bailey has the same tools the Docker
# one does: git and openssh for the workspace repos, mkcert for local
# certificates, restic for the nightly backups, syft for image SBOMs.
#
# Build context = the bitswan-automation-server module root, with the binary
# already built (the Makefile target does both):
#   go build -o bitswan . && docker build -f Dockerfile.k8s -t bitswan/automation-server:dev .
ARG RUNTIME_IMAGE=bitswan/automation-server-runtime:latest
FROM ${RUNTIME_IMAGE}

COPY bitswan /usr/local/bin/bitswan
RUN chmod 0755 /usr/local/bin/bitswan && /usr/local/bin/bitswan version

CMD ["/usr/local/bin/bitswan", "automation-server-daemon", "__run"]
