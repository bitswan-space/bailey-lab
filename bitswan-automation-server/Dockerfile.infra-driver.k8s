# The infra driver for a Kubernetes namespace.
#
# Built from source rather than layered onto the Docker driver's image, because
# layering onto a prebuilt image ships whatever binary that image happened to
# carry — which is how this arrived as a pod crash-looping on "unknown flag:
# --driver" while the tests reported the chapter as passing.
#
# It carries kubectl and buildctl where the Docker variant carries the docker
# CLI and compose: those are what it shells out to. Nothing here speaks to a
# Docker socket, because there is none to speak to.
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-w -s" -o /infra-driver ./cmd/infra-driver

FROM debian:stable
RUN set -e && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl git && \
    rm -rf /var/lib/apt/lists/*

ARG KUBECTL_VERSION=v1.31.5
RUN curl -fsSL -o /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/$(dpkg --print-architecture)/kubectl" && \
    chmod 0755 /usr/local/bin/kubectl && kubectl version --client=true

# A build here is a push to the registry the kubelet pulls from, and this is
# what talks to the builder.
ARG BUILDKIT_VERSION=0.19.0
RUN curl -fsSL "https://github.com/moby/buildkit/releases/download/v${BUILDKIT_VERSION}/buildkit-v${BUILDKIT_VERSION}.linux-$(dpkg --print-architecture).tar.gz" \
        | tar -xz -C /usr/local --strip-components=1 bin/buildctl && \
    buildctl --version

COPY --from=build /infra-driver /usr/local/bin/infra-driver

CMD ["/usr/local/bin/infra-driver", "--help"]
